        "def calculate_total_price(price: int, tax_rate: int) -> int:\n",
        "    return int(price * (1 + tax_rate / 100))\n",
        "\n",
        "price = 110\n",
        "tax_rate = 10\n",
        "\n",
        "print(calculate_total_price(price, tax_rate))"
      ]
